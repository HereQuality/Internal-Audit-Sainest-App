<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Internal Audit App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>internal_audit_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to attach photos to your profile, support tickets, and audit responses.</string>
	<key>NSCameraUsageDescription</key>
	<string>Used to take photos to attach to your profile, support tickets, and audit responses.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- flutter_background_service_ios registers this exact identifier with
	     BGTaskScheduler (SwiftFlutterBackgroundServicePlugin.taskIdentifier)
	     and submits a BGAppRefreshTaskRequest for it. iOS refuses to
	     register a task identifier that isn't listed here, so without this
	     key the background refresh silently never ran. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.flutter.background.refresh</string>
	</array>
	<!-- Best-effort only — see NOTIFICATIONS.md. "fetch" lets iOS
	     opportunistically wake the app for background_service's
	     onIosBackground handler, but the OS decides if/when (no guaranteed
	     interval, no android_alarm_manager_plus equivalent here); this is
	     NOT a substitute for FCM/APNs if you need reliable iOS delivery.
	     "processing" is deliberately NOT declared: the plugin uses
	     BGAppRefreshTask only, there is no BGProcessingTask code anywhere in
	     the app or its pods, and declaring it failed App Store upload with
	     ITMS-90771 (and invites an App Review 2.5.4 rejection).
	     "remote-notification" IS the reliable one — required for a
	     data-only FCM/APNs push (fcm_service.dart sends no `notification`
	     block, only `data`) to reach didReceiveRemoteNotification while
	     backgrounded at all; without it iOS just drops a silent push
	     outright. Needs the Push Notifications capability + an APNs key
	     uploaded to Firebase too — see NOTIFICATIONS.md's "FCM push setup"
	     for the Apple Developer Program side of this, which no Info.plist
	     edit can substitute for. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
