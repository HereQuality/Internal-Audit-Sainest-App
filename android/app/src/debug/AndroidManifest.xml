<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds install next to the Play Store app (applicationIdSuffix ".debug" in app/build.gradle.kts),
         so they get their own launcher name to tell the two icons apart. -->
    <!-- usesCleartextTraffic: a debug build may talk to the local server over plain http
         (API_BASE_URL set to http://MAC-IP:5001/api/v1 via dart-define); Android 9+ blocks that otherwise.
         Debug only: the release build keeps the default (https only). -->
    <application
        android:label="Q Audit360 (dev)"
        android:usesCleartextTraffic="true"
        tools:replace="android:label" />
</manifest>
