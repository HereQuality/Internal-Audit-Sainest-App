<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- image_picker's ImageSource.camera needs a camera to actually
         resolve at runtime — declared optional so this still installs on
         camera-less devices/emulators, falling back to gallery-only there. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- ── Overdue-NC local notification pipeline (see lib/core/notifications) ──
         POST_NOTIFICATIONS: runtime-requested via permission_handler on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Required alongside a typed FGS declaration below — Android 14+ (and
         mandatory as of targetSdk 36) requires every foreground service to
         declare a type; DATA_SYNC matches the periodic-poll nature of the
         overdue-NC watcher (see background_entrypoints.dart). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- USE_FULL_SCREEN_INTENT removed — showFullScreenAlarm() in
         local_notifications.dart is wired up but deliberately unused (see
         NOTIFICATIONS.md's "Full-screen, lock-screen alarm-style
         notification" section); declaring the permission with no live
         caller only invites Play Store review scrutiny for nothing. Re-add
         it alongside actually wiring that method up, if a genuine
         hard-deadline alert feature ships later. -->

    <application
        android:label="Q Audit360"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- android:enableOnBackInvokedCallback below is disabled, not
             enabled — Android 14's animated predictive-back swipe preview
             is where the "screen goes unresponsive after swiping back, only
             the back button still works" bug came from: a half-completed/
             cancelled predictive-back gesture can leave the Navigator's
             hit-testing pointed at the wrong route (a documented Flutter/
             Android-14 interaction, worse on heavily customized OEM
             gesture-nav skins like this device's ColorOS). Falling back to
             the older immediate-pop back behavior trades the animated swipe
             preview for actually working reliably every time. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:enableOnBackInvokedCallback="false"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_background_service's own manifest (merged in
             automatically from the plugin's AAR) declares BackgroundService
             itself with exported="true"/stopWithTask="false" but no
             foregroundServiceType — this override adds the type via
             tools:node="merge" (attributes merge into the plugin's
             declaration rather than conflicting with it) since Android now
             requires every FGS to declare one. Must stay in sync with the
             foregroundServiceTypes passed to AndroidConfiguration in
             background_entrypoints.dart — the runtime call's type must be a
             subset of what's declared here. On start it posts the
             persistent "Watching for overdue NCs" notification and polls
             every 15 minutes until nobody is signed in, push is switched
             off, or kServiceMaxRuntime has passed (backgroundServiceOnStart
             in background_entrypoints.dart) — Android 15+ ends a dataSync
             service that runs ~6 h in the background by killing the whole
             app, and the plugin has no Service.onTimeout to react to that,
             so the service stops itself first and is restarted the next
             time the app is in the foreground. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- The plugin's BootReceiver restarts BackgroundService on
             BOOT_COMPLETED, QUICKBOOT_POWERON and MY_PACKAGE_REPLACED
             (every reboot and every app update) with no check that anyone
             is signed in or push is on, so a signed-out phone grew a
             permanent "Watching for overdue NCs" notification. Android 15+
             also forbids a BOOT_COMPLETED receiver from starting a dataSync
             foreground service — an uncaught exception there. Removed here
             rather than only via autoStartOnBoot: false in
             background_entrypoints.dart, because that flag is persisted
             natively and only rewritten when the app next launches, i.e.
             after the update's own broadcast has already fired. The app
             starts the service itself: at login, when push is switched
             on, and whenever it returns to the foreground. Real delivery
             after a reboot is FCM's job and needs no service. -->
        <receiver
            android:name="id.flutter.flutter_background_service.BootReceiver"
            tools:node="remove" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
